{
  "format": "ohpe-preset",
  "version": 2,
  "kind": "part",
  "name": "Piano Scan Table",
  "author": "groovex",
  "tags": [
    "Keys",
    "Piano"
  ],
  "engine": "wavetable",
  "comment": "A wavetable analysed from the recorded grand piano, eight frames from the hammer to the fading tail. The mod envelope scans through it with every note, so each key starts bright and settles like the piano did; velocity opens the tone. The mod wheel holds it on the bright frames.",
  "params": {
    "engine": 1,
    "wavetable.table": 0,
    "wavetable.pos": 0.0,
    "wavetable.warp": 0.0,
    "wavetable.tone": 0.62,
    "wavetable.unison": 0.15,
    "wavetable.univoices": 3,
    "wavetable.uniwidth": 0.5,
    "wavetable.keytrack": 0.5,
    "wavetable.envpos": 0.8,
    "wavetable.lfopos": 0.0,
    "usertable.wt": 1,
    "amp.a": 0.003,
    "amp.d": 2.5,
    "amp.s": 0.3,
    "amp.r": 0.6,
    "mod.a": 0.001,
    "mod.d": 2.2,
    "mod.s": 0.15,
    "mod.r": 0.6,
    "mod.amt": 0.0,
    "lfo.rate": 0.13,
    "lfo.depth": 0.12,
    "lfo.shape": 0,
    "lfo.dest": 3,
    "expr.vel.dst1": 1,
    "expr.vel.amt1": 0.35,
    "expr.vel.curve1": 1,
    "fx.type": 1,
    "fx.chorus.rate": 0.4,
    "fx.chorus.depth": 0.4,
    "fx.chorus.mix": 0.25,
    "fx.chorus.voices": 3,
    "fx.chorus.drift": 0.3,
    "fx.chorus.spread": 0.85,
    "fx.chorus.lowcut": 180.0,
    "fx2.type": 6,
    "fx2.reverb.size": 0.5,
    "fx2.reverb.damping": 0.5,
    "fx2.reverb.predelay": 0.02,
    "fx2.reverb.mix": 0.16,
    "mod.s1.src": 9,
    "mod.s1.via": 0,
    "mod.s1.dst": 11,
    "mod.s1.amt": -0.5,
    "mod.s1.curve": 0,
    "voices": 12,
    "velsens": 0.65,
    "glide": 0.0,
    "gain": 17.2,
    "chordroom": 15.4
  },
  "usertables": {
    "wavetable": {
      "name": "Piano Scan",
      "file": "ohpe-factory-piano-scan.ohpewt",
      "frames": 8,
      "data": ""
    }
  }
