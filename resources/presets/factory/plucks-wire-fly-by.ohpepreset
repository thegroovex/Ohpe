{
  "format": "ohpe-preset",
  "version": 2,
  "kind": "part",
  "name": "Wire Fly-By",
  "author": "groovex",
  "tags": [
    "Plucks",
    "3D"
  ],
  "engine": "pluck",
  "comment": "A steel-string pluck that flies past you from front-left to back-right every bar, its pitch bending with the Doppler effect as it passes. The mod wheel speeds up the flights. Best with headphones.",
  "params": {
    "engine": 3,
    "pluck.material": 0.6,
    "pluck.damping": 0.3,
    "pluck.bright": 0.6,
    "pluck.body": 0.4,
    "pluck.excite": 0.5,
    "pluck.pickpos": 0.2,
    "pluck.bodysize": 0.45,
    "amp.a": 0.002,
    "amp.d": 1.5,
    "amp.s": 0.0,
    "amp.r": 0.8,
    "mod.a": 0.01,
    "mod.d": 0.5,
    "mod.s": 0.0,
    "mod.r": 0.3,
    "mod.amt": 0.0,
    "lfo.rate": 0.1,
    "lfo.depth": 0.06,
    "lfo.shape": 0,
    "lfo.dest": 1,
    "space.on": 1,
    "space.path": 3,
    "space.pathlen": 4,
    "space.pathrate": 1.0,
    "space.pathsize": 0.6,
    "space.pathphase": 0.0,
    "space.azimuth": 0.0,
    "space.elevation": 0.0,
    "space.distance": 1.8,
    "space.spread": 15.0,
    "space.room": 0.3,
    "space.roomsize": 0.45,
    "space.doppler": 0.55,
    "space.air": 0.6,
    "space.rolloff": 0.7,
    "space.lowkeep": 120.0,
    "space.glide": 0.06,
    "fx.type": 6,
    "fx.reverb.size": 0.5,
    "fx.reverb.damping": 0.45,
    "fx.reverb.predelay": 0.02,
    "fx.reverb.mix": 0.12,
    "mod.s1.src": 9,
    "mod.s1.via": 0,
    "mod.s1.dst": 70,
    "mod.s1.amt": 0.6,
    "mod.s1.curve": 0,
    "voices": 10,
    "velsens": 0.6,
    "glide": 0.0,
    "gain": 6.0
  }
}
