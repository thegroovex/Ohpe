    "mod.amt": 0.1,
    "voices": 1,
    "fx.type": 7,
    "fx.shaper.type": 3,
    "fx.shaper.drive": 0.3,
    "fx.shaper.bias": 0.05,
    "fx.shaper.tone": 4000,
