{
  "format": "ohpe-preset",
  "version": 2,
  "kind": "part",
  "name": "Pressure Vowel",
  "author": "groovex",
  "tags": [
    "Vocal",
    "Leads"
  ],
  "engine": "vocal",
  "comment": "A solo voice that opens its mouth as you press: aftertouch moves the vowel from 'oo' to 'ah' and velocity sets the volume. Overlapping notes slide, longer with pressure. The mod wheel adds vibrato.",
  "params": {
    "engine": 5,
    "vocal.vowel": 4.0,
    "vocal.formant": 0.5,
    "vocal.breath": 0.3,
    "vocal.tension": 0.45,
    "vocal.vibdepth": 0.0,
    "vocal.vibrate": 5.2,
    "vocal.jitter": 0.15,
    "amp.a": 0.05,
    "amp.d": 0.4,
    "amp.s": 0.9,
    "amp.r": 0.3,
    "mod.a": 0.05,
    "mod.d": 0.4,
    "mod.s": 0.4,
    "mod.r": 0.3,
    "mod.amt": 0.0,
    "voices": 1,
    "glide": 0.06,
    "glide.mode": 1,
    "glide.rate": 0,
    "glide.press": 0.6,
    "expr.vel.dst1": 3,
    "expr.vel.amt1": 0.3,
    "expr.vel.curve1": 0,
    "expr.at.dst1": 14,
    "expr.at.amt1": -0.5,
    "expr.at.curve1": 3,
    "lfo.rate": 5.2,
    "lfo.depth": 0.0,
    "lfo.shape": 0,
    "lfo.dest": 0,
    "fx.type": 6,
    "fx.reverb.size": 0.55,
    "fx.reverb.damping": 0.5,
    "fx.reverb.predelay": 0.02,
    "fx.reverb.mix": 0.18,
    "mod.s1.src": 9,
    "mod.s1.via": 0,
    "mod.s1.dst": 31,
    "mod.s1.amt": 0.12,
    "mod.s1.curve": 0,
    "velsens": 0.4,
    "gain": 5.7
  }
}
