    "cluster.shape": 0.25,
    "cluster.side": 0.6,
    "cluster.reso": 0.08,
    "cluster.keytrack": 0.5,
    "cluster.drift": 0.5,
    "amp.a": 1.5,
    "amp.d": 2.0,
    "amp.s": 0.9,
    "amp.r": 3.0,
    "mod.a": 1.5,
    "mod.d": 2.0,
    "mod.s": 0.7,
    "mod.r": 2.0,
    "mod.amt": 0.1,
