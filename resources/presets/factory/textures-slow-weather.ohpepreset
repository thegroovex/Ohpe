{
  "format": "ohpe-preset",
  "version": 2,
  "kind": "part",
  "name": "Slow Weather",
  "author": "groovex",
  "tags": [
    "Textures"
  ],
  "engine": "cluster",
  "comment": "A cluster drone that keeps changing like weather: full Life, Alive turned up, and a tone swell locked to four-bar cycles of the tempo. Hold a note and listen; the mod wheel brightens the sky.",
