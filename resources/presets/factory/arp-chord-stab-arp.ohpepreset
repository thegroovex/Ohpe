    "amp.s": 0.0,
    "amp.r": 0.15,
    "mod.a": 0.002,
    "mod.d": 0.15,
    "mod.s": 0.0,
    "mod.r": 0.1,
    "mod.amt": 0.45,
    "fx.type": 11,
    "fx.multiband.depth": 0.4,
