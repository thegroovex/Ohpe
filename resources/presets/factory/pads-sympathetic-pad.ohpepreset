{
  "format": "ohpe-preset",
  "version": 2,
  "kind": "part",
  "name": "Sympathetic Pad",
  "author": "groovex",
  "tags": [
    "Pads",
    "MPE"
  ],
  "engine": "analog",
  "comment": "A warm pad that wakes a set of sympathetic strings tuned to the chord you hold - they keep ringing after release.",
  "params": {
    "engine": 2,
    "analog.shape": 0.6,
    "analog.detune": 0.25,
    "analog.cutoff": 1800,
    "analog.reso": 0.1,
    "analog.oscmix": 0.5,
    "analog.sub": 0.2,
    "analog.noise": 0.05,
    "analog.drive": 0.1,
    "analog.keytrack": 0.5,
    "analog.osclevel": 0.0,
    "amp.a": 0.8,
    "amp.d": 1.0,
    "amp.s": 0.8,
    "amp.r": 2.5,
    "mod.a": 1.0,
    "mod.d": 2.0,
    "mod.s": 0.5,
    "mod.r": 2.0,
    "mod.amt": 0.1,
    "reso.on": 1,
    "reso.model": 0,
    "reso.follow": 2,
    "reso.tune": 0.0,
    "reso.size": 1.0,
    "reso.material": 0.6,
    "reso.decay": 6.0,
    "reso.position": 0.35,
    "reso.inharm": 0.15,
    "reso.sympathetic": 0.9,
    "reso.width": 0.9,
    "reso.drive": 0.0,
    "reso.mix": 0.5,
    "reso.pressamt": 0.6,
    "reso.slideamt": 0.5,
    "fx.type": 6,
    "fx.reverb.size": 0.75,
    "fx.reverb.damping": 0.45,
    "fx.reverb.predelay": 0.03,
    "fx.reverb.mix": 0.22,
    "voices": 10,
    "life": 0.2,
    "gain": 7.3,
    "mod.s1.src": 9,
    "mod.s1.via": 0,
    "mod.s1.dst": 4,
    "mod.s1.amt": 0.3,
    "mod.s1.curve": 0,
    "chordroom": 4.5
  }
}
