{
  "format": "ohpe-preset",
  "version": 2,
  "kind": "part",
  "name": "Halo Carousel",
  "author": "groovex",
  "tags": [
    "Pads",
    "3D"
  ],
  "engine": "wavetable",
  "comment": "A glassy unison pad that circles your head once every eight bars at a few steps' distance, its wide image turning with it. Pressure draws it closer; the mod wheel speeds the carousel up. Best with headphones.",
  "params": {
    "engine": 1,
    "wavetable.table": 4,
    "wavetable.pos": 0.35,
    "wavetable.warp": 0.12,
    "wavetable.tone": 0.55,
    "wavetable.unison": 0.4,
    "wavetable.univoices": 4,
    "wavetable.uniwidth": 0.85,
    "wavetable.keytrack": 0.35,
    "wavetable.lfopos": 0.18,
    "amp.a": 1.2,
    "amp.d": 2.0,
    "amp.s": 0.9,
    "amp.r": 3.0,
    "mod.a": 1.5,
    "mod.d": 2.0,
    "mod.s": 0.6,
    "mod.r": 2.5,
    "mod.amt": 0.1,
    "lfo.rate": 0.08,
    "lfo.depth": 0.22,
    "lfo.shape": 1,
    "lfo.dest": 1,
    "space.on": 1,
    "space.path": 1,
    "space.pathlen": 7,
    "space.pathrate": 1.0,
    "space.pathsize": 0.5,
    "space.pathphase": 0.0,
    "space.azimuth": 0.0,
    "space.elevation": 0.0,
    "space.distance": 2.6,
    "space.spread": 90.0,
    "space.room": 0.35,
    "space.roomsize": 0.6,
    "space.doppler": 0.1,
    "space.air": 0.6,
    "space.rolloff": 0.7,
    "space.lowkeep": 120.0,
    "space.glide": 0.06,
    "expr.at.dst1": 1,
    "expr.at.amt1": 0.25,
    "expr.at.curve1": 3,
    "fx.type": 6,
    "fx.reverb.size": 0.8,
    "fx.reverb.damping": 0.45,
    "fx.reverb.predelay": 0.02,
    "fx.reverb.mix": 0.2,
    "mod.s1.src": 12,
    "mod.s1.via": 0,
    "mod.s1.dst": 69,
    "mod.s1.amt": -0.08,
    "mod.s1.curve": 0,
    "mod.s2.src": 9,
    "mod.s2.via": 0,
    "mod.s2.dst": 70,
    "mod.s2.amt": 0.45,
    "mod.s2.curve": 0,
    "voices": 10,
    "velsens": 0.25,
    "glide": 0.0,
    "gain": 6.0
  }
}
