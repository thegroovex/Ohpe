    "analog.shape": 0.1,
    "analog.detune": 0.06,
    "analog.cutoff": 420,
    "analog.reso": 0.25,
    "analog.oscmix": 0.25,
    "analog.sub": 0.0,
    "analog.drive": 0.3,
    "analog.keytrack": 0.45,
    "amp.a": 0.003,
    "amp.d": 0.6,
    "amp.s": 0.75,
    "amp.r": 0.08,
    "mod.a": 0.002,
    "mod.d": 0.22,
    "mod.s": 0.1,
    "mod.r": 0.1,
    "mod.amt": 0.45,
    "voices": 1,
    "sub.level": 0.55,
    "sub.oct": 1,
    "sub.shape": 0,
    "sub.direct": 1,
    "expr.vel.dst1": 1,
    "expr.vel.amt1": 0.35,
    "expr.vel.curve1": 1,
    "expr.at.dst1": 1,
    "expr.at.amt1": 0.4,
    "expr.at.curve1": 3,
