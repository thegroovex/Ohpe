{
  "format": "ohpe-preset",
  "version": 2,
  "kind": "part",
  "name": "Sub Pressure Bass",
  "author": "groovex",
  "tags": [
    "Bass"
  ],
  "engine": "analog",
  "comment": "A tight saw bass over a clean sine sub two octaves down that stays full under the closed filter. Velocity bites into the filter, pressure opens it; the mod wheel hardens the attack and drive.",
