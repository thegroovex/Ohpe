{
  "format": "ohpe-preset",
  "version": 2,
  "kind": "part",
  "name": "Vowel Orbit Lead",
  "author": "groovex",
  "tags": [
    "Leads",
    "3D",
    "Vocal"
  ],
  "engine": "vocal",
  "comment": "A singing vowel lead circling you every four bars like a voice moving through the room. Pressure adds vibrato; the mod wheel walks the vowel from 'ah' to 'ee'. Best with headphones.",
