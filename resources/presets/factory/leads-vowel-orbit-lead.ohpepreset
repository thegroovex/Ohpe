    "vocal.vibrate": 5.2,
    "vocal.jitter": 0.1,
    "amp.a": 0.03,
    "amp.d": 0.6,
    "amp.s": 0.9,
    "amp.r": 0.4,
    "mod.a": 0.01,
    "mod.d": 0.5,
    "mod.s": 0.5,
    "mod.r": 0.4,
    "mod.amt": 0.0,
