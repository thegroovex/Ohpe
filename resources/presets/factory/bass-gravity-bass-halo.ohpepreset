{
  "format": "ohpe-preset",
  "version": 2,
  "kind": "part",
  "name": "Gravity Bass Halo",
  "author": "groovex",
  "tags": [
    "Bass",
    "3D"
  ],
  "engine": "analog",
  "comment": "A vowel-like analog bass whose partials Key Gravity tunes into the key; the halo of overtones circles in a figure-eight over the centred sub. The mod wheel deepens the gravity. Best with headphones.",
