{
  "format": "ohpe-preset",
  "version": 2,
  "kind": "part",
  "name": "Living Nylon",
  "author": "groovex",
  "tags": [
    "Plucks"
  ],
  "engine": "pluck",
  "comment": "A warm nylon string with a little Life: every note drifts and breathes a touch differently, like a hand-played guitar. Velocity plucks brighter; the mod wheel moves the pluck towards the bridge.",
  "params": {
    "engine": 3,
    "pluck.material": 0.0,
    "pluck.damping": 0.3,
    "pluck.bright": 0.3,
    "pluck.body": 0.5,
    "pluck.excite": 0.42,
    "pluck.pickpos": 0.25,
    "pluck.bodysize": 0.6,
    "amp.a": 0.002,
    "amp.d": 2.5,
    "amp.s": 0.0,
    "amp.r": 0.35,
    "mod.a": 0.001,
    "mod.d": 0.4,
    "mod.s": 0.0,
    "mod.r": 0.3,
    "mod.amt": 0.1,
    "lfo.rate": 0.13,
    "lfo.depth": 0.12,
    "lfo.shape": 0,
    "lfo.dest": 3,
    "life": 0.35,
    "expr.vel.dst1": 1,
    "expr.vel.amt1": 0.35,
    "expr.vel.curve1": 1,
    "fx.type": 6,
    "fx.reverb.size": 0.45,
    "fx.reverb.damping": 0.5,
    "fx.reverb.predelay": 0.02,
    "fx.reverb.mix": 0.14,
    "mod.s1.src": 9,
    "mod.s1.via": 0,
    "mod.s1.dst": 10,
    "mod.s1.amt": -0.4,
    "mod.s1.curve": 0,
    "voices": 12,
    "velsens": 0.65,
    "glide": 0.0,
    "gain": 9.9,
    "chordroom": 4.5
  }
}
