{
  "format": "ohpe-preset",
  "version": 2,
  "kind": "part",
  "name": "Resonant Comb Arp",
  "author": "groovex",
  "tags": [
    "Arp"
  ],
  "engine": "analog",
  "comment": "A plucky saw arpeggio through the Resonator as a rack effect: a string body tuned to the chord you hold rings under every step. The mod wheel brings the body forward, the echo is a synced dotted eighth.",
  "params": {
    "engine": 2,
    "analog.shape": 0.05,
    "analog.detune": 0.06,
    "analog.cutoff": 1400,
    "analog.reso": 0.25,
    "analog.oscmix": 0.3,
    "analog.sub": 0.0,
    "analog.drive": 0.2,
    "analog.keytrack": 0.5,
    "amp.a": 0.003,
    "amp.d": 0.25,
    "amp.s": 0.0,
    "amp.r": 0.15,
    "mod.a": 0.002,
    "mod.d": 0.15,
    "mod.s": 0.0,
    "mod.r": 0.1,
    "mod.amt": 0.45,
    "lfo.rate": 0.09,
    "lfo.depth": 0.15,
    "lfo.shape": 1,
    "lfo.dest": 1,
    "expr.vel.dst1": 1,
    "expr.vel.amt1": 0.3,
    "expr.vel.curve1": 0,
    "fx.type": 23,
    "fx.resonator.model": 0,
    "fx.resonator.follow": 2,
    "fx.resonator.tune": 0.0,
    "fx.resonator.size": 0.7,
    "fx.resonator.material": 0.6,
    "fx.resonator.decay": 2.5,
    "fx.resonator.position": 0.25,
    "fx.resonator.inharm": 0.1,
    "fx.resonator.sympathetic": 0.6,
    "fx.resonator.width": 0.8,
    "fx.resonator.drive": 0.0,
    "fx.resonator.mix": 0.35,
    "fx2.type": 14,
    "fx2.echo.sync": 9,
    "fx2.echo.feedback": 0.3,
    "fx2.echo.mix": 0.18,
    "fx3.type": 6,
    "fx3.reverb.size": 0.5,
    "fx3.reverb.damping": 0.5,
    "fx3.reverb.predelay": 0.02,
    "fx3.reverb.mix": 0.12,
    "mod.s1.src": 9,
    "mod.s1.via": 0,
    "mod.s1.dst": 37,
    "mod.s1.amt": 0.4,
    "mod.s1.curve": 0,
