{
  "format": "ohpe-preset",
  "version": 2,
  "kind": "part",
  "name": "Echo Harp",
  "author": "groovex",
  "tags": [
    "Plucks",
    "MPE"
  ],
  "engine": "pluck",
  "comment": "Plucked nylon-like string with dotted ping-pong echoes and a wide room.",
  "params": {
    "engine": 3,
    "pluck.material": 0.15,
    "pluck.damping": 0.35,
    "pluck.bright": 0.55,
    "pluck.body": 0.5,
    "pluck.excite": 0.5,
    "pluck.pickpos": 0.2,
    "pluck.bodysize": 0.6,
    "amp.a": 0.002,
    "amp.d": 2.0,
    "amp.s": 0.0,
    "amp.r": 0.4,
    "mod.a": 0.001,
    "mod.d": 0.3,
    "mod.s": 0.0,
    "mod.r": 0.2,
    "mod.amt": 0.0,
    "fx.type": 5,
    "fx.delay.time": 0.45,
    "fx.delay.feedback": 0.45,
    "fx.delay.tone": 0.45,
    "fx.delay.pingpong": 1,
    "fx.delay.mix": 0.28,
    "fx2.type": 6,
    "fx2.reverb.size": 0.7,
    "fx2.reverb.damping": 0.5,
    "fx2.reverb.predelay": 0.02,
    "fx2.reverb.mix": 0.22,
    "lfo.rate": 0.09,
    "lfo.depth": 0.22,
    "lfo.shape": 1,
    "lfo.dest": 1,
    "mpe.press": 9,
    "mpe.pressamt": 0.7,
    "mpe.timbre": 5,
    "mpe.timbreamt": 0.7,
    "mpe.slide": 0.05,
    "mpe.smooth": 0.02,
    "mpe.bend": 48,
    "voices": 10,
    "velsens": 0.6,
    "gain": 0.0
  }
}
