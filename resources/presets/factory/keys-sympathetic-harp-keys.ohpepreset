{
  "format": "ohpe-preset",
  "version": 2,
  "kind": "part",
  "name": "Sympathetic Harp Keys",
  "author": "groovex",
  "tags": [
    "Keys",
    "Plucks"
  ],
  "engine": "pluck",
  "comment": "A bright harp-like pluck that wakes a bank of sympathetic strings tuned to the chord you hold: chords keep shimmering after you let go. Velocity plucks harder; the mod wheel brings the sympathetic strings forward.",
  "params": {
    "engine": 3,
    "pluck.material": 0.05,
    "pluck.damping": 0.3,
    "pluck.bright": 0.55,
    "pluck.body": 0.35,
    "pluck.excite": 0.45,
    "pluck.pickpos": 0.18,
    "pluck.bodysize": 0.45,
    "amp.a": 0.002,
    "amp.d": 3.0,
    "amp.s": 0.0,
    "amp.r": 1.0,
    "mod.a": 0.001,
    "mod.d": 0.4,
    "mod.s": 0.0,
    "mod.r": 0.3,
    "mod.amt": 0.1,
    "reso.on": 1,
    "reso.model": 0,
    "reso.follow": 2,
    "reso.tune": 0.0,
    "reso.size": 0.85,
    "reso.material": 0.6,
    "reso.decay": 4.0,
    "reso.position": 0.3,
    "reso.inharm": 0.12,
    "reso.sympathetic": 0.7,
    "reso.width": 0.85,
    "reso.drive": 0.0,
    "reso.mix": 0.35,
    "reso.pressamt": 0.5,
    "reso.slideamt": 0.5,
    "expr.vel.dst1": 1,
    "expr.vel.amt1": 0.35,
    "expr.vel.curve1": 1,
    "expr.at.dst1": 10,
    "expr.at.amt1": 0.3,
    "expr.at.curve1": 0,
    "lfo.rate": 0.13,
    "lfo.depth": 0.15,
    "lfo.shape": 0,
    "lfo.dest": 3,
    "fx.type": 6,
    "fx.reverb.size": 0.55,
    "fx.reverb.damping": 0.45,
    "fx.reverb.predelay": 0.02,
    "fx.reverb.mix": 0.15,
    "mod.s1.src": 9,
    "mod.s1.via": 0,
    "mod.s1.dst": 80,
    "mod.s1.amt": 0.4,
    "mod.s1.curve": 0,
    "voices": 12,
    "velsens": 0.65,
    "glide": 0.0,
    "gain": 10.0
  }
