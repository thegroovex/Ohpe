    "analog.detune": 0.12,
    "analog.cutoff": 1800,
    "analog.reso": 0.35,
    "analog.oscmix": 0.5,
    "analog.sub": 0.1,
    "analog.drive": 0.4,
    "analog.keytrack": 0.6,
    "amp.a": 0.004,
    "amp.d": 0.5,
    "amp.s": 0.8,
    "amp.r": 0.25,
    "mod.a": 0.002,
    "mod.d": 0.3,
    "mod.s": 0.3,
    "mod.r": 0.2,
    "mod.amt": 0.35,
    "lfo.rate": 5.0,
    "lfo.depth": 0.04,
    "lfo.shape": 0,
    "lfo.dest": 0,
    "space.on": 1,
    "space.path": 6,
    "space.pathlen": 5,
    "space.pathrate": 1.0,
    "space.pathsize": 0.45,
    "space.pathphase": 0.0,
    "space.azimuth": 0.0,
    "space.elevation": 0.0,
    "space.distance": 1.6,
    "space.spread": 20.0,
    "space.room": 0.25,
