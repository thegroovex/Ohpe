{
  "format": "ohpe-preset",
  "version": 2,
  "kind": "part",
  "name": "Spiral Sync Lead",
  "author": "groovex",
  "tags": [
    "Leads",
    "3D"
  ],
  "engine": "analog",
  "comment": "A hard-edged analog lead spiralling up around your head every two bars and dropping back to the front. The mod wheel opens the resonant filter. Best with headphones.",
