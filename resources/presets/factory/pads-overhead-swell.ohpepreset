{
  "format": "ohpe-preset",
  "version": 2,
  "kind": "part",
  "name": "Overhead Swell",
  "author": "groovex",
  "tags": [
    "Pads",
    "3D"
  ],
  "engine": "vocal",
  "comment": "Breathy voices that rise from in front of you, pass over your head and land behind you (motion path Over the Head, four bars, in tempo). Pressure swells them; the mod wheel adds a choir vibrato. Best with headphones.",
  "params": {
    "engine": 5,
    "vocal.vowel": 1.0,
    "vocal.formant": 0.5,
    "vocal.breath": 0.5,
    "vocal.tension": 0.35,
    "vocal.vibdepth": 0.1,
    "vocal.vibrate": 4.8,
    "vocal.jitter": 0.2,
    "amp.a": 1.0,
    "amp.d": 1.5,
    "amp.s": 0.9,
    "amp.r": 2.5,
    "mod.a": 0.5,
    "mod.d": 2.0,
    "mod.s": 0.5,
    "mod.r": 1.5,
    "mod.amt": 0.0,
    "lfo.rate": 0.09,
    "lfo.depth": 0.2,
    "lfo.shape": 1,
    "lfo.dest": 1,
    "space.on": 1,
    "space.path": 11,
    "space.pathlen": 6,
    "space.pathrate": 1.0,
    "space.pathsize": 0.6,
    "space.pathphase": 0.0,
    "space.azimuth": 0.0,
    "space.elevation": 0.0,
    "space.distance": 2.0,
    "space.spread": 60.0,
    "space.room": 0.35,
    "space.roomsize": 0.6,
    "space.doppler": 0.2,
    "space.air": 0.6,
    "space.rolloff": 0.7,
    "space.lowkeep": 120.0,
    "space.glide": 0.06,
    "expr.at.dst1": 3,
    "expr.at.amt1": 0.25,
    "expr.at.curve1": 3,
    "fx.type": 6,
    "fx.reverb.size": 0.75,
    "fx.reverb.damping": 0.45,
    "fx.reverb.predelay": 0.03,
    "fx.reverb.mix": 0.22,
    "mod.s1.src": 32,
    "mod.s1.via": 9,
    "mod.s1.dst": 1,
    "mod.s1.amt": 0.02,
    "mod.s1.curve": 0,
    "voices": 8,
