    "cluster.detune": 0.05,
    "cluster.spread": 0.3,
    "cluster.tone": 0.4,
    "cluster.chord": 0,
    "cluster.stack": 1,
    "cluster.shape": 0.2,
    "cluster.side": 0.2,
    "cluster.reso": 0.1,
    "cluster.keytrack": 0.6,
    "cluster.drift": 0.1,
    "amp.a": 0.004,
    "amp.d": 1.5,
    "amp.s": 0.4,
    "amp.r": 1.2,
    "reso.on": 1,
    "reso.model": 1,
    "reso.follow": 1,
    "reso.tune": 0.0,
    "reso.size": 0.5,
    "reso.material": 1.0,
    "reso.decay": 2.5,
    "reso.position": 0.45,
    "reso.inharm": 0.4,
    "reso.sympathetic": 0.3,
    "reso.width": 0.9,
    "reso.drive": 0.0,
    "reso.mix": 0.45,
    "reso.pressamt": 0.5,
    "reso.slideamt": 0.5,
    "fx.type": 6,
    "fx.reverb.size": 0.6,
    "fx.reverb.damping": 0.35,
    "fx.reverb.predelay": 0.02,
    "fx.reverb.mix": 0.2,
    "voices": 10,
    "mod.a": 0.005,
    "gain": 0.0
  }
