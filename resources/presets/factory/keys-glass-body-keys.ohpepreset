{
  "format": "ohpe-preset",
  "version": 2,
  "kind": "part",
  "name": "Glass Body Keys",
  "author": "groovex",
  "tags": [
    "Keys",
    "MPE"
  ],
  "engine": "cluster",
  "comment": "Soft keys through a glass plate tuned to each note: a glassy halo over the chord.",
  "params": {
