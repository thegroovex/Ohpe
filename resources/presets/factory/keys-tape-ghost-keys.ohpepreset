{
  "format": "ohpe-preset",
  "version": 2,
  "kind": "part",
  "name": "Tape Ghost Keys",
  "author": "groovex",
  "tags": [
    "Keys",
    "Hybrid",
    "Piano",
    "MPE"
  ],
  "engine": "sampler",
  "comment": "Tine piano with a ghost of itself: a detuned grain copy, crushed and flanged like an old resampled tape.",
  "params": {
    "engine": 7,
    "sampler.tone": 0.85,
    "sampler.inst2": 3,
    "grain.pos": 0.05,
    "grain.size": 180,
    "grain.density": 40,
    "grain.spray": 0.2,
    "grain.reverse": 0.35,
    "grain.spread": 1.0,
    "grain.scan": 0.02,
    "grain.tone": 0.6,
    "grain.inst2": 3,
    "layer.engine": 5,
    "layer.level": 0.5,
    "layer.tune": 0,
    "layer.fine": -14.0,
    "layer.xmode": 0,
    "layer.xmod": 0.0,
    "layer.width": 0.8,
    "layer.ownenv": 1,
    "layer.a": 0.3,
    "layer.d": 2.0,
    "layer.s": 0.5,
    "layer.r": 2.5,
    "amp.a": 0.001,
    "amp.d": 4.0,
    "amp.s": 0.0,
    "amp.r": 0.6,
    "mod.a": 0.001,
    "mod.d": 0.3,
    "mod.s": 0.0,
    "mod.r": 0.2,
    "mod.amt": 0.0,
    "fx.type": 11,
    "fx.bitcrush.bits": 11,
    "fx.bitcrush.downsample": 2,
    "fx.bitcrush.mix": 0.3,
    "fx.flanger.rate": 0.07,
    "fx.flanger.depth": 0.5,
    "fx.flanger.feedback": 0.3,
    "fx.flanger.delay": 4.0,
    "fx.flanger.mix": 0.3,
    "lfo.rate": 0.13,
    "lfo.depth": 0.18,
    "lfo.shape": 0,
    "lfo.dest": 3,
    "mpe.press": 12,
    "mpe.pressamt": 0.8,
    "mpe.timbre": 5,
    "mpe.timbreamt": 0.7,
    "mpe.slide": 0.08,
    "mpe.smooth": 0.04,
    "mpe.bend": 48,
    "voices": 12,
    "velsens": 0.6,
    "gain": 0.0
  }
