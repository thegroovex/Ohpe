    "fx3.compressor.thresh": -4.0,
    "fx3.compressor.ratio": 8.0,
    "fx3.compressor.attack": 0.1,
    "fx3.compressor.release": 180.0,
    "fx3.compressor.knee": 6.0,
    "fx3.compressor.makeup": 0.0,
    "fx3.compressor.mix": 1.0,
    "mod.s1.src": 9,
