    "amp.s": 1.0,
    "amp.r": 0.25,
    "mod.a": 0.001,
    "mod.d": 0.3,
    "mod.s": 1.0,
    "mod.r": 0.2,
    "mod.amt": 0.0,
    "voices": 10,
    "fx.type": 1,
    "fx.chorus.rate": 0.2,
    "fx.chorus.depth": 0.55,
    "fx.chorus.mix": 0.3,
    "fx.chorus.voices": 4,
    "fx.chorus.drift": 0.45,
    "fx.chorus.spread": 0.85,
    "fx.chorus.lowcut": 180.0,
    "fx2.type": 6,
    "fx2.reverb.size": 0.7,
    "fx2.reverb.damping": 0.5,
