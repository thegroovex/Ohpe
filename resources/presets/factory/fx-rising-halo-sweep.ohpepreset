{
  "format": "ohpe-preset",
  "version": 2,
  "kind": "part",
  "name": "Rising Halo Sweep",
  "author": "groovex",
  "tags": [
    "FX",
    "3D"
  ],
  "engine": "wavetable",
  "comment": "A riser that spirals up and over your head in four bars (motion path Spiral Up, in tempo) while its tone opens. Hold a note for the build; the mod wheel speeds it up. Best with headphones.",
  "params": {
    "engine": 1,
    "wavetable.table": 5,
    "wavetable.pos": 0.2,
    "wavetable.warp": 0.2,
    "wavetable.tone": 0.3,
    "wavetable.unison": 0.5,
    "wavetable.univoices": 6,
    "wavetable.uniwidth": 0.9,
    "wavetable.keytrack": 0.3,
    "wavetable.envpos": 0.6,
    "wavetable.lfopos": 0.0,
    "amp.a": 2.5,
    "amp.d": 1.0,
    "amp.s": 1.0,
    "amp.r": 1.5,
    "mod.a": 4.0,
    "mod.d": 1.0,
    "mod.s": 1.0,
    "mod.r": 1.5,
    "mod.amt": 0.6,
    "lfo.rate": 0.09,
    "lfo.depth": 0.15,
    "lfo.shape": 1,
    "lfo.dest": 1,
    "space.on": 1,
    "space.path": 6,
    "space.pathlen": 6,
    "space.pathrate": 1.0,
    "space.pathsize": 0.6,
    "space.pathphase": 0.0,
    "space.azimuth": 0.0,
    "space.elevation": 0.0,
    "space.distance": 2.5,
    "space.spread": 60.0,
    "space.room": 0.35,
    "space.roomsize": 0.6,
    "space.doppler": 0.25,
    "space.air": 0.6,
    "space.rolloff": 0.7,
    "space.lowkeep": 120.0,
    "space.glide": 0.06,
    "expr.vel.dst1": 5,
    "expr.vel.amt1": -0.3,
    "expr.vel.curve1": 0,
    "fx.type": 6,
    "fx.reverb.size": 0.8,
    "fx.reverb.damping": 0.4,
    "fx.reverb.predelay": 0.04,
    "fx.reverb.mix": 0.25,
    "mod.s1.src": 9,
    "mod.s1.via": 0,
    "mod.s1.dst": 70,
    "mod.s1.amt": 0.4,
    "mod.s1.curve": 0,
    "voices": 4,
    "velsens": 0.25,
    "glide": 0.0,
    "gain": 15.4,
    "chordroom": 11.6
  }
}
