{
  "format": "ohpe-preset",
  "version": 2,
  "kind": "part",
  "name": "Tempo Wobble Sub",
  "author": "groovex",
  "tags": [
    "Bass"
  ],
  "engine": "analog",
  "comment": "A growling filter wobble locked to the tempo (LFO 2 on eighth notes, retriggered with each note) over a steady mono sub that never wobbles. The mod wheel deepens the wobble.",
  "params": {
    "engine": 2,
    "analog.shape": 0.0,
    "analog.detune": 0.12,
    "analog.cutoff": 300,
    "analog.reso": 0.45,
    "analog.oscmix": 0.5,
    "analog.sub": 0.0,
    "analog.drive": 0.5,
    "analog.keytrack": 0.4,
    "amp.a": 0.003,
    "amp.d": 0.5,
    "amp.s": 0.85,
    "amp.r": 0.1,
    "mod.a": 0.001,
    "mod.d": 0.2,
    "mod.s": 0.0,
    "mod.r": 0.1,
    "mod.amt": 0.0,
    "voices": 1,
    "lfo2.rate": 2.0,
    "lfo2.sync": 6,
    "lfo2.shape": 0,
    "lfo2.mode": 1,
    "lfo2.depth": 0.55,
    "lfo2.fade": 0.0,
    "lfo2.phase": 0.0,
    "sub.level": 0.6,
    "sub.oct": 0,
    "sub.shape": 0,
    "sub.direct": 1,
    "lfo.depth": 0.0,
    "expr.vel.dst1": 1,
    "expr.vel.amt1": 0.2,
    "expr.vel.curve1": 0,
    "fx.type": 8,
    "fx.distortion.mode": 0,
    "fx.distortion.drive": 0.25,
    "fx.distortion.mix": 0.5,
    "fx.distortion.output": 0.0,
    "fx2.type": 10,
    "fx2.compressor.thresh": -14,
    "fx2.compressor.ratio": 3.5,
    "fx2.compressor.attack": 1.5,
    "fx2.compressor.release": 80,
    "fx2.compressor.knee": 6.0,
    "fx2.compressor.makeup": 0.0,
    "fx2.compressor.mix": 1.0,
    "mod.s1.src": 2,
    "mod.s1.via": 0,
    "mod.s1.dst": 7,
    "mod.s1.amt": 0.45,
    "mod.s1.curve": 0,
    "mod.s2.src": 9,
    "mod.s2.via": 0,
    "mod.s2.dst": 33,
    "mod.s2.amt": 0.45,
