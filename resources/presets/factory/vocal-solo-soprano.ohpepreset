{
  "format": "ohpe-preset",
  "version": 2,
  "kind": "part",
  "name": "Solo Soprano",
  "author": "groovex",
  "tags": [
    "Vocal",
    "Leads"
  ],
  "engine": "vocal",
  "comment": "High solo voice: bright formants, generous vibrato.",
  "params": {
    "engine": 5,
    "vocal.vowel": 0.3,
    "vocal.formant": 3.0,
    "vocal.breath": 0.12,
    "vocal.tension": 0.62,
    "vocal.vibdepth": 0.35,
    "vocal.vibrate": 5.8,
    "vocal.jitter": 0.12,
    "amp.a": 0.06,
    "amp.d": 0.5,
    "amp.s": 0.9,
    "amp.r": 0.35,
    "mod.a": 0.1,
    "mod.d": 0.8,
    "mod.s": 0.3,
    "mod.r": 0.3,
    "mod.amt": 0.15,
    "fx.type": 6,
    "fx.reverb.size": 0.7,
    "fx.reverb.damping": 0.45,
    "fx.reverb.predelay": 0.03,
    "fx.reverb.mix": 0.25,
    "voices": 1,
    "glide": 0.06,
    "gain": 6.8
  }
}
