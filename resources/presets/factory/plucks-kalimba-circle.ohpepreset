{
  "format": "ohpe-preset",
  "version": 2,
  "kind": "part",
  "name": "Kalimba Circle",
  "author": "groovex",
  "tags": [
    "Plucks",
    "3D"
  ],
  "engine": "sampler",
  "comment": "Kalimba notes placed around a circle by pitch: low notes on your left, high notes behind you to the right, the whole ring turning once per bar. The mod wheel brightens the tines. Best with headphones.",
  "params": {
    "engine": 7,
    "sampler.inst": 1,
    "sampler.start": 0.0,
    "sampler.tone": 0.5,
    "amp.a": 0.002,
    "amp.d": 1.2,
    "amp.s": 0.0,
    "amp.r": 0.7,
    "mod.a": 0.01,
    "mod.d": 1.0,
    "mod.s": 0.0,
    "mod.r": 0.5,
    "mod.amt": 0.0,
    "lfo.rate": 0.1,
    "lfo.depth": 0.1,
    "lfo.shape": 0,
    "lfo.dest": 1,
    "space.on": 1,
    "space.path": 1,
    "space.pathlen": 4,
    "space.pathrate": 1.0,
    "space.pathsize": 0.3,
    "space.pathphase": 0.0,
    "space.azimuth": 0.0,
    "space.elevation": 0.0,
    "space.distance": 1.5,
    "space.spread": 20.0,
    "space.room": 0.3,
    "space.roomsize": 0.45,
    "space.doppler": 0.1,
    "space.air": 0.6,
    "space.rolloff": 0.7,
    "space.lowkeep": 120.0,
    "space.glide": 0.02,
    "fx.type": 14,
    "fx.echo.sync": 9,
    "fx.echo.feedback": 0.25,
    "fx.echo.mix": 0.12,
    "fx2.type": 6,
    "fx2.reverb.size": 0.5,
    "fx2.reverb.damping": 0.45,
    "fx2.reverb.predelay": 0.02,
    "fx2.reverb.mix": 0.12,
    "mod.s1.src": 8,
    "mod.s1.via": 0,
    "mod.s1.dst": 67,
    "mod.s1.amt": 0.45,
    "mod.s1.curve": 0,
    "mod.s2.src": 9,
    "mod.s2.via": 0,
    "mod.s2.dst": 6,
    "mod.s2.amt": 0.4,
    "mod.s2.curve": 0,
    "voices": 10,
    "velsens": 0.55,
    "glide": 0.0,
    "gain": 6.0
  }
}
