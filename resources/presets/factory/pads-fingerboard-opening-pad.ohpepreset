{
  "format": "ohpe-preset",
  "version": 2,
  "kind": "part",
  "name": "Fingerboard Opening Pad",
  "author": "groovex",
  "tags": [
    "Pads",
    "MPE",
    "Fingerboard"
  ],
  "engine": "wavetable",
  "comment": "A wide wavetable pad for continuous fingerboards that opens as you slide your finger forward (Y opens the filter and the table position); pressure swells it. Hold chords and move single fingers.",
  "params": {
    "engine": 1,
    "wavetable.table": 3,
    "wavetable.pos": 0.3,
    "wavetable.warp": 0.2,
    "wavetable.tone": 0.4,
    "wavetable.unison": 0.35,
    "wavetable.univoices": 6,
    "wavetable.uniwidth": 0.5,
    "wavetable.keytrack": 0.4,
    "wavetable.lfopos": 0.12,
    "amp.a": 0.25,
    "amp.d": 1.5,
    "amp.s": 0.85,
    "amp.r": 1.8,
    "mod.a": 0.6,
    "mod.d": 1.5,
    "mod.s": 0.6,
    "mod.r": 1.5,
    "mod.amt": 0.1,
    "lfo.rate": 0.09,
    "lfo.depth": 0.2,
    "lfo.shape": 1,
    "lfo.dest": 1,
    "char.bright": -0.25,
    "char.wide": -0.2,
    "expr.vel.dst1": 5,
    "expr.vel.amt1": -0.2,
    "expr.vel.curve1": 0,
    "fx.type": 6,
    "fx.reverb.size": 0.7,
    "fx.reverb.damping": 0.45,
    "fx.reverb.predelay": 0.03,
    "fx.reverb.mix": 0.22,
    "mod.s1.src": 12,
    "mod.s1.via": 0,
    "mod.s1.dst": 81,
    "mod.s1.amt": 0.7,
    "mod.s1.curve": 3,
    "mod.s2.src": 9,
    "mod.s2.via": 0,
    "mod.s2.dst": 84,
    "mod.s2.amt": 0.7,
    "mod.s2.curve": 0,
    "voices": 10,
    "velsens": 0.15,
    "glide": 0.0,
    "gain": 18.1,
    "mpe.slide": 0.0,
    "mpe.smooth": 0.015,
    "mpe.hd": 1,
    "mpe.round": 0,
    "mpe.press": 6,
    "mpe.pressamt": 0.3,
    "mpe.timbre": 5,
    "mpe.timbreamt": 0.8,
    "mpe.pcurve": -0.2,
    "chordroom": 14.8
  }
}
