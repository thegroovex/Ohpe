{
  "format": "ohpe-preset",
  "version": 2,
  "kind": "part",
  "name": "Swarm Sequence",
  "author": "groovex",
  "tags": [
    "Arp",
    "3D"
  ],
  "engine": "cluster",
  "comment": "Detuned cluster stabs arpeggiated in eighths, each note flying off with a swarm that never lands twice in the same place. The mod wheel widens the stack. Best with headphones.",
