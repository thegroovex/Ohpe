{
  "format": "ohpe-preset",
  "version": 2,
  "kind": "part",
  "name": "Halo Spiral Pad",
  "author": "groovex",
  "tags": [
    "Pads",
    "3D"
  ],
  "engine": "wavetable",
  "comment": "A glassy wavetable pad that spirals upwards around your head over sixteen bars and starts again below (motion path Spiral Up, measured in bars: it follows the tempo). Best with headphones; the mod wheel speeds up the spiral.",
  "params": {
    "engine": 1,
    "wavetable.table": 4,
    "wavetable.pos": 0.4,
    "wavetable.warp": 0.1,
    "wavetable.tone": 0.55,
    "wavetable.unison": 0.35,
    "wavetable.univoices": 4,
    "wavetable.uniwidth": 0.8,
    "wavetable.keytrack": 0.35,
    "wavetable.lfopos": 0.2,
    "amp.a": 1.0,
    "amp.d": 2.0,
    "amp.s": 0.9,
    "amp.r": 3.0,
    "mod.a": 1.2,
    "mod.d": 2.0,
    "mod.s": 0.6,
    "mod.r": 2.5,
    "mod.amt": 0.12,
    "lfo.rate": 0.1,
    "lfo.depth": 0.25,
    "lfo.shape": 1,
    "lfo.dest": 1,
    "space.on": 1,
    "space.path": 6,
    "space.pathlen": 8,
    "space.pathrate": 1.0,
    "space.pathsize": 0.55,
    "space.pathphase": 0.0,
    "space.azimuth": 0.0,
    "space.elevation": 0.0,
    "space.distance": 3.0,
    "space.spread": 70.0,
    "space.room": 0.35,
    "space.roomsize": 0.6,
    "space.doppler": 0.15,
    "space.air": 0.6,
    "space.rolloff": 0.7,
    "space.lowkeep": 120.0,
    "space.glide": 0.06,
    "expr.at.dst1": 1,
    "expr.at.amt1": 0.3,
    "expr.at.curve1": 3,
    "fx.type": 6,
    "fx.reverb.size": 0.8,
    "fx.reverb.damping": 0.45,
    "fx.reverb.predelay": 0.04,
    "fx.reverb.mix": 0.25,
    "mod.s1.src": 9,
    "mod.s1.via": 0,
    "mod.s1.dst": 70,
    "mod.s1.amt": 0.35,
    "mod.s1.curve": 0,
    "voices": 8,
    "velsens": 0.25,
    "glide": 0.0,
    "gain": 13.7,
    "chordroom": 13.3
  }
}
