{
  "format": "ohpe-preset",
  "version": 2,
  "kind": "part",
  "name": "Angel Overhead",
  "author": "groovex",
  "tags": [
    "Vocal",
    "3D"
  ],
  "engine": "vocal",
  "comment": "A pure, high 'ooh' voice floating over your head and down behind you every eight bars, like a singer in the gallery. The mod wheel opens the vowel. Best with headphones.",
