    "fx2.reverb.damping": 0.55,
    "fx2.reverb.predelay": 0.01,
    "fx2.reverb.mix": 0.12,
    "mod.s1.src": 9,
    "mod.s1.via": 0,
    "mod.s1.dst": 43,
    "mod.s1.amt": 0.6,
    "mod.s1.curve": 0,
