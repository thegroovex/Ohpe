{
  "format": "ohpe-preset",
  "version": 2,
  "kind": "part",
  "name": "Breathing Organ",
  "author": "groovex",
  "tags": [
    "Keys"
  ],
  "engine": "analog",
  "comment": "A drawbar-like organ that is never quite still: Life drifts every voice a few cents and breathes in its tone, like an old instrument warming up. The mod wheel speeds up the rotating chorus.",
  "params": {
    "engine": 2,
    "analog.shape": 0.85,
    "analog.detune": 0.05,
    "analog.cutoff": 3200,
    "analog.reso": 0.05,
    "analog.osc2oct": 1,
    "analog.oscmix": 0.45,
    "analog.sub": 0.4,
    "analog.drive": 0.2,
    "analog.keytrack": 0.5,
    "amp.a": 0.004,
    "amp.d": 0.2,
    "amp.s": 1.0,
    "amp.r": 0.08,
    "mod.a": 0.002,
    "mod.d": 0.3,
    "mod.s": 0.0,
    "mod.r": 0.1,
    "mod.amt": 0.0,
    "lfo.rate": 0.7,
    "lfo.depth": 0.0,
    "lfo.shape": 0,
    "lfo.dest": 3,
    "life": 0.45,
    "char.hard": 0.15,
    "char.alive": 0.2,
    "expr.vel.dst1": 3,
    "expr.vel.amt1": 0.15,
    "expr.vel.curve1": 0,
    "expr.at.dst1": 11,
    "expr.at.amt1": 0.12,
    "expr.at.curve1": 3,
    "fx.type": 1,
    "fx.chorus.rate": 0.9,
    "fx.chorus.depth": 0.45,
    "fx.chorus.mix": 0.45,
    "fx.chorus.voices": 3,
    "fx.chorus.drift": 0.3,
    "fx.chorus.spread": 0.85,
