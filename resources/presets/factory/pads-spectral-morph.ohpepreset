{
  "format": "ohpe-preset",
  "version": 2,
  "kind": "part",
  "name": "Spectral Morph",
  "author": "groovex",
  "tags": [
    "Pads",
    "Hybrid",
    "MPE"
  ],
  "engine": "wavetable",
  "comment": "Formant table morphing under a breathy vocal layer, both through a drifting comb: spectra that melt into each other.",
  "params": {
    "engine": 1,
    "wavetable.table": 2,
    "wavetable.pos": 0.2,
    "wavetable.tone": 0.65,
    "wavetable.unison": 0.35,
    "wavetable.univoices": 5,
    "wavetable.uniwidth": 1.0,
    "wavetable.keytrack": 0.4,
    "wavetable.lfopos": 0.6,
    "vocal.vowel": 2.0,
    "vocal.formant": 0.0,
    "vocal.breath": 0.5,
    "vocal.tension": 0.4,
    "vocal.vibdepth": 0.05,
    "vocal.vibrate": 4.5,
    "vocal.jitter": 0.2,
    "layer.engine": 6,
    "layer.level": 0.5,
    "layer.tune": 0,
    "layer.fine": 0.0,
    "layer.xmode": 0,
    "layer.xmod": 0.18,
    "layer.width": 0.7,
    "amp.a": 1.0,
    "amp.d": 2.0,
    "amp.s": 0.9,
    "amp.r": 3.5,
    "mod.a": 1.0,
    "mod.d": 2.0,
    "mod.s": 0.6,
    "mod.r": 2.0,
    "mod.amt": 0.1,
    "lfo.rate": 0.05,
    "lfo.depth": 0.9,
    "lfo.shape": 1,
    "lfo.dest": 1,
    "fx.type": 6,
    "fx.reverb.size": 0.93,
    "fx.reverb.damping": 0.4,
    "fx.reverb.predelay": 0.05,
    "fx.reverb.mix": 0.42,
    "mpe.press": 12,
    "mpe.pressamt": 0.8,
    "mpe.timbre": 6,
    "mpe.timbreamt": 0.7,
    "mpe.slide": 0.08,
    "mpe.smooth": 0.04,
    "mpe.bend": 48,
    "voices": 6,
    "gain": 0.0
  }
}
