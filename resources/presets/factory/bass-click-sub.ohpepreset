{
  "format": "ohpe-preset",
  "version": 2,
  "kind": "part",
  "name": "Click Sub",
  "author": "groovex",
  "tags": [
    "Bass"
  ],
  "engine": "analog",
  "comment": "Sine sub with a sharp click on top, so the bass line reads on small speakers.",
  "params": {
    "engine": 2,
    "analog.shape": 0.5,
    "analog.detune": 0.0,
    "analog.cutoff": 320,
    "analog.reso": 0.05,
    "analog.oscmix": 0.0,
    "analog.sub": 1.0,
    "analog.noise": 0.25,
    "analog.drive": 0.35,
    "analog.keytrack": 1.0,
    "analog.osclevel": 0.15,
    "amp.a": 0.003,
    "amp.d": 0.8,
    "amp.s": 0.8,
    "amp.r": 0.08,
    "mod.a": 0.002,
    "mod.d": 0.012,
    "mod.s": 0.0,
    "mod.r": 0.02,
    "mod.amt": 0.9,
    "voices": 1,
    "fx.type": 8,
    "fx.squash.depth": 0.3,
    "fx.squash.time": 0.2,
    "fx.squash.upward": 0.3,
    "fx.squash.low": 0.0,
    "fx.squash.mid": 0.0,
    "fx.squash.high": 0.0,
    "fx.squash.mix": 1.0,
    "fx.squash.output": 0.0,
    "fx.squash.monolow": 1,
    "lfo.rate": 0.17,
    "lfo.depth": 0.12,
    "lfo.shape": 1,
    "lfo.dest": 1,
    "velsens": 0.35,
    "gain": 0.0
  }
