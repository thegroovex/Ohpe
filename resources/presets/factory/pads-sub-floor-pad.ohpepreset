{
  "format": "ohpe-preset",
  "version": 2,
  "kind": "part",
  "name": "Sub Floor Pad",
  "author": "groovex",
  "tags": [
    "Pads"
  ],
  "engine": "analog",
  "comment": "A dark, warm pad with a round SUB layer one octave down that gives chords a floor without a bass part. Velocity brings in more of the sub; the mod wheel opens the pad above it.",
  "params": {
    "engine": 2,
    "analog.shape": 0.45,
    "analog.detune": 0.2,
    "analog.cutoff": 900,
    "analog.reso": 0.1,
    "analog.oscmix": 0.5,
    "analog.sub": 0.0,
    "analog.drive": 0.1,
    "analog.keytrack": 0.5,
    "amp.a": 0.6,
    "amp.d": 1.2,
    "amp.s": 0.9,
    "amp.r": 1.8,
    "mod.a": 0.8,
    "mod.d": 1.5,
    "mod.s": 0.6,
    "mod.r": 1.5,
    "mod.amt": 0.1,
    "lfo.rate": 0.09,
    "lfo.depth": 0.2,
    "lfo.shape": 1,
    "lfo.dest": 1,
    "sub.level": 0.22,
    "sub.oct": 0,
    "sub.shape": 1,
    "sub.direct": 0,
    "expr.vel.dst1": 20,
    "expr.vel.amt1": 0.25,
    "expr.vel.curve1": 0,
    "expr.vel.dst2": 5,
    "expr.vel.amt2": -0.2,
    "expr.vel.curve2": 0,
    "fx.type": 1,
    "fx.chorus.rate": 0.25,
    "fx.chorus.depth": 0.6,
    "fx.chorus.mix": 0.35,
    "fx.chorus.voices": 4,
    "fx.chorus.drift": 0.45,
    "fx.chorus.spread": 0.85,
    "fx.chorus.lowcut": 200.0,
    "fx2.type": 6,
    "fx2.reverb.size": 0.7,
    "fx2.reverb.damping": 0.5,
    "fx2.reverb.predelay": 0.03,
    "fx2.reverb.mix": 0.2,
    "mod.s1.src": 9,
    "mod.s1.via": 0,
    "mod.s1.dst": 4,
    "mod.s1.amt": 0.45,
    "mod.s1.curve": 0,
    "voices": 10,
    "velsens": 0.3,
    "monobass": 150.0,
    "glide": 0.0,
    "gain": 3.8
  }
