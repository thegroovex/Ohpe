    "sampler.start": 0.0,
    "sampler.tone": 0.58,
    "amp.a": 0.002,
    "amp.d": 1.8,
    "amp.s": 0.0,
    "amp.r": 1.0,
    "mod.a": 0.01,
    "mod.d": 1.0,
    "mod.s": 0.0,
    "mod.r": 0.5,
    "mod.amt": 0.0,
    "lfo.rate": 0.1,
    "lfo.depth": 0.06,
    "lfo.shape": 0,
    "lfo.dest": 1,
    "space.on": 1,
    "space.path": 8,
    "space.pathlen": 5,
    "space.pathrate": 1.0,
    "space.pathsize": 0.6,
    "space.pathphase": 0.0,
    "space.azimuth": 0.0,
    "space.elevation": 0.0,
    "space.distance": 1.7,
    "space.spread": 30.0,
    "space.room": 0.35,
    "space.roomsize": 0.55,
    "space.doppler": 0.1,
    "space.air": 0.6,
    "space.rolloff": 0.7,
    "space.lowkeep": 120.0,
    "space.glide": 0.06,
    "fx.type": 6,
    "fx.reverb.size": 0.65,
    "fx.reverb.damping": 0.45,
    "fx.reverb.predelay": 0.02,
