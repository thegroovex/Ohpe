{
  "format": "ohpe-preset",
  "version": 2,
  "kind": "part",
  "name": "Zither Drizzle",
  "author": "groovex",
  "tags": [
    "Plucks",
    "3D"
  ],
  "engine": "sampler",
  "comment": "Zither strings scattered by a swarm path, every pluck coming from a slightly different place like a light drizzle. The mod wheel darkens the strings. Best with headphones.",
