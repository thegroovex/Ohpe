{
  "format": "ohpe-preset",
  "version": 2,
  "kind": "part",
  "name": "Whisper Room",
  "author": "groovex",
  "tags": [
    "Textures",
    "3D"
  ],
  "engine": "vocal",
  "comment": "Breath and whispered vowels close to your ears, moving like someone walking around you (motion path Whisper, four bars, in tempo). Pressure adds breath; the mod wheel changes the vowel. Best with headphones.",
  "params": {
    "engine": 5,
    "vocal.vowel": 2.0,
    "vocal.formant": 0.5,
    "vocal.breath": 0.85,
    "vocal.tension": 0.25,
    "vocal.vibdepth": 0.05,
    "vocal.vibrate": 4.5,
    "vocal.jitter": 0.3,
    "amp.a": 0.6,
    "amp.d": 1.5,
    "amp.s": 0.85,
    "amp.r": 2.0,
    "mod.a": 0.5,
    "mod.d": 2.0,
    "mod.s": 0.5,
    "mod.r": 1.5,
    "mod.amt": 0.0,
    "lfo.rate": 0.09,
    "lfo.depth": 0.2,
    "lfo.shape": 1,
    "lfo.dest": 1,
    "space.on": 1,
    "space.path": 9,
    "space.pathlen": 6,
    "space.pathrate": 1.0,
    "space.pathsize": 0.5,
    "space.pathphase": 0.0,
    "space.azimuth": 0.0,
    "space.elevation": 0.0,
    "space.distance": 0.6,
    "space.spread": 30.0,
    "space.room": 0.2,
    "space.roomsize": 0.35,
    "space.doppler": 0.1,
    "space.air": 0.6,
    "space.rolloff": 0.7,
    "space.lowkeep": 120.0,
    "space.glide": 0.06,
    "expr.at.dst1": 15,
    "expr.at.amt1": 0.35,
    "expr.at.curve1": 3,
    "fx.type": 6,
    "fx.reverb.size": 0.5,
    "fx.reverb.damping": 0.5,
    "fx.reverb.predelay": 0.02,
    "fx.reverb.mix": 0.15,
    "mod.s1.src": 9,
    "mod.s1.via": 0,
    "mod.s1.dst": 5,
    "mod.s1.amt": 0.4,
    "mod.s1.curve": 0,
    "voices": 6,
    "velsens": 0.25,
