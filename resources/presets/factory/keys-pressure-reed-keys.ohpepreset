{
  "format": "ohpe-preset",
  "version": 2,
  "kind": "part",
  "name": "Pressure Reed Keys",
  "author": "groovex",
  "tags": [
    "Keys",
    "Piano"
  ],
  "engine": "sampler",
  "comment": "The recorded reed electric piano made for aftertouch: press into a chord and it growls (drive) and wavers (vibrato); velocity sets the bark. The mod wheel brings in a pulsing auto-pan.",
  "params": {
    "engine": 7,
    "sampler.start": 0.0,
    "sampler.tone": 0.7,
    "sampler.inst2": 4,
    "amp.a": 0.001,
    "amp.d": 3.0,
    "amp.s": 0.7,
    "amp.r": 0.4,
    "mod.a": 0.001,
    "mod.d": 0.5,
    "mod.s": 0.2,
    "mod.r": 0.3,
    "mod.amt": 0.0,
    "lfo.rate": 5.0,
    "lfo.depth": 0.0,
    "lfo.shape": 0,
    "lfo.dest": 3,
    "expr.vel.dst1": 1,
    "expr.vel.amt1": 0.3,
    "expr.vel.curve1": 1,
    "expr.at.dst1": 18,
    "expr.at.amt1": 0.45,
    "expr.at.curve1": 3,
    "expr.at.dst2": 11,
    "expr.at.amt2": 0.12,
    "expr.at.curve2": 3,
    "fx.type": 8,
    "fx.distortion.mode": 0,
    "fx.distortion.drive": 0.15,
    "fx.distortion.mix": 0.35,
    "fx.distortion.output": 0.0,
    "fx2.type": 6,
    "fx2.reverb.size": 0.4,
    "fx2.reverb.damping": 0.5,
    "fx2.reverb.predelay": 0.02,
    "fx2.reverb.mix": 0.12,
    "mod.s1.src": 9,
    "mod.s1.via": 0,
    "mod.s1.dst": 31,
    "mod.s1.amt": 0.6,
    "mod.s1.curve": 0,
    "voices": 12,
    "velsens": 0.7,
    "glide": 0.0,
    "gain": 2.3,
    "chordroom": 10.9
  }
}
