    "analog.drive": 0.2,
    "analog.keytrack": 0.6,
    "amp.a": 0.02,
    "amp.d": 0.8,
    "amp.s": 0.8,
    "amp.r": 0.4,
    "mod.a": 0.01,
    "mod.d": 0.6,
    "mod.s": 0.4,
    "mod.r": 0.3,
