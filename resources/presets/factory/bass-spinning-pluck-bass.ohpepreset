{
  "format": "ohpe-preset",
  "version": 2,
  "kind": "part",
  "name": "Spinning Pluck Bass",
  "author": "groovex",
  "tags": [
    "Bass",
    "3D"
  ],
  "engine": "pluck",
  "comment": "A plucked string bass: the woody attack spins once around your head every half bar, the low note stays centred. The mod wheel lets the string sustain. Best with headphones.",
