    "mod.s1.dst": 67,
    "mod.s1.amt": 0.5,
    "mod.s1.curve": 0,
    "mod.s2.src": 15,
    "mod.s2.via": 0,
    "mod.s2.dst": 68,
    "mod.s2.amt": 0.12,
    "mod.s2.curve": 0,
    "mod.s3.src": 9,
    "mod.s3.via": 0,
    "mod.s3.dst": 68,
    "mod.s3.amt": 0.25,
    "mod.s3.curve": 0,
