{
  "format": "ohpe-preset",
  "version": 2,
  "kind": "part",
  "name": "Harp Constellation",
  "author": "groovex",
  "tags": [
    "Plucks",
    "3D"
  ],
  "engine": "sampler",
  "comment": "Every harp note appears as a star at its own random place around and above you, then the next one lights up elsewhere. The mod wheel lifts the constellation higher. Best with headphones.",
  "params": {
    "engine": 7,
    "sampler.inst": 5,
    "sampler.start": 0.0,
    "sampler.tone": 0.55,
    "amp.a": 0.002,
    "amp.d": 2.0,
    "amp.s": 0.0,
    "amp.r": 1.2,
    "mod.a": 0.01,
    "mod.d": 1.0,
    "mod.s": 0.0,
    "mod.r": 0.5,
    "mod.amt": 0.0,
    "lfo.rate": 0.1,
    "lfo.depth": 0.06,
    "lfo.shape": 0,
    "lfo.dest": 1,
    "space.on": 1,
    "space.path": 0,
    "space.pathlen": 4,
    "space.pathrate": 1.0,
    "space.pathsize": 0.0,
    "space.pathphase": 0.0,
    "space.azimuth": 0.0,
    "space.elevation": 10.0,
    "space.distance": 1.8,
    "space.spread": 15.0,
    "space.room": 0.35,
    "space.roomsize": 0.6,
    "space.doppler": 0.0,
    "space.air": 0.6,
    "space.rolloff": 0.7,
    "space.lowkeep": 120.0,
    "space.glide": 0.01,
    "fx.type": 6,
    "fx.reverb.size": 0.7,
    "fx.reverb.damping": 0.45,
    "fx.reverb.predelay": 0.02,
    "fx.reverb.mix": 0.16,
    "mod.s1.src": 15,
