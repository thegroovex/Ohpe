{
  "format": "ohpe-preset",
  "version": 2,
  "kind": "part",
  "name": "Ping-Pong Space Pluck",
  "author": "groovex",
  "tags": [
    "Plucks",
    "3D"
  ],
  "engine": "pluck",
  "comment": "A bright pluck that bounces front to back every half bar, starting again with every note (motion path Ping-Pong front/back, in tempo) inside a small room. Velocity plucks harder; the mod wheel speeds up the bounce. Best with headphones.",
  "params": {
    "engine": 3,
    "pluck.material": 0.2,
    "pluck.damping": 0.4,
    "pluck.bright": 0.42,
    "pluck.body": 0.35,
    "pluck.excite": 0.45,
    "pluck.pickpos": 0.18,
    "pluck.bodysize": 0.4,
    "amp.a": 0.002,
    "amp.d": 1.5,
    "amp.s": 0.0,
    "amp.r": 0.5,
    "mod.a": 0.001,
    "mod.d": 0.3,
    "mod.s": 0.0,
    "mod.r": 0.2,
    "mod.amt": 0.1,
    "lfo.rate": 0.09,
    "lfo.depth": 0.15,
    "lfo.shape": 1,
    "lfo.dest": 1,
    "space.on": 1,
    "space.path": 7,
    "space.pathlen": 3,
    "space.pathrate": 1.0,
    "space.pathsize": 0.6,
    "space.pathphase": 0.0,
    "space.azimuth": 0.0,
    "space.elevation": 0.0,
    "space.distance": 2.0,
    "space.spread": 20.0,
    "space.room": 0.3,
    "space.roomsize": 0.4,
    "space.doppler": 0.2,
    "space.air": 0.6,
    "space.rolloff": 0.7,
    "space.lowkeep": 120.0,
    "space.glide": 0.06,
    "expr.vel.dst1": 1,
    "expr.vel.amt1": 0.35,
    "expr.vel.curve1": 1,
    "fx.type": 6,
    "fx.reverb.size": 0.4,
    "fx.reverb.damping": 0.5,
    "fx.reverb.predelay": 0.02,
    "fx.reverb.mix": 0.12,
    "mod.s1.src": 9,
    "mod.s1.via": 0,
    "mod.s1.dst": 70,
    "mod.s1.amt": 0.35,
    "mod.s1.curve": 0,
    "voices": 10,
    "velsens": 0.7,
    "glide": 0.0,
    "gain": 13.9,
    "chordroom": 5.1,
    "space.retrig": 2
  }
}
