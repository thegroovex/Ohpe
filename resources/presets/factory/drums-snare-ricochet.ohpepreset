    "analog.sub": 0.0,
    "analog.noise": 0.8,
    "analog.drive": 0.25,
    "analog.keytrack": 0.2,
    "amp.a": 0.001,
    "amp.d": 0.2,
    "amp.s": 0.0,
    "amp.r": 0.12,
    "mod.a": 0.001,
    "mod.d": 0.06,
    "mod.s": 0.0,
    "mod.r": 0.05,
    "mod.amt": 0.5,
    "pitchenv.amt": 0.4,
    "pitchenv.time": 0.03,
    "pitchenv.curve": 0.5,
    "space.on": 1,
    "space.path": 7,
