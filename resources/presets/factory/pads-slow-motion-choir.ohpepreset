    "vocal.vowel": 3.6,
    "vocal.formant": 0.0,
    "vocal.breath": 0.25,
    "vocal.tension": 0.45,
    "vocal.vibdepth": 0.12,
    "vocal.vibrate": 4.6,
    "vocal.jitter": 0.25,
    "amp.a": 1.4,
    "amp.d": 2.0,
    "amp.s": 0.9,
    "amp.r": 3.5,
    "mod.a": 1.0,
    "mod.d": 2.0,
    "mod.s": 0.6,
    "mod.r": 2.0,
    "mod.amt": 0.1,
    "fx.type": 1,
    "fx.chorus.rate": 0.2,
    "fx.chorus.depth": 0.6,
    "fx.chorus.mix": 0.4,
    "fx2.type": 20,
    "fx2.width.width": 1.5,
    "fx2.width.spread": 0.3,
    "fx2.width.haas": 14,
    "fx2.width.mono": 150,
    "fx2.width.output": 0.0,
    "fx3.type": 6,
    "fx3.reverb.size": 0.95,
    "fx3.reverb.damping": 0.4,
    "fx3.reverb.predelay": 0.05,
    "fx3.reverb.mix": 0.45,
    "lfo.rate": 0.09,
    "lfo.depth": 0.22,
    "lfo.shape": 1,
    "lfo.dest": 1,
    "mpe.press": 10,
