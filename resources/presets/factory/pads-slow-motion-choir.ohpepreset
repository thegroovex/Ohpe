{
  "format": "ohpe-preset",
  "version": 2,
  "kind": "part",
  "name": "Slow Motion Choir",
  "author": "groovex",
  "tags": [
    "Pads",
    "Vocal",
    "MPE"
  ],
  "engine": "vocal",
  "comment": "Ooh choir that swells in slowly, chorused and wide, in a long cathedral hall.",
  "params": {
