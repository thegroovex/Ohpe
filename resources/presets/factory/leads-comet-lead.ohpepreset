{
  "format": "ohpe-preset",
  "version": 2,
  "kind": "part",
  "name": "Comet Lead",
  "author": "groovex",
  "tags": [
    "Leads",
    "3D"
  ],
  "engine": "wavetable",
  "comment": "A bright wavetable lead that streaks past you with every note it plays, rising in pitch as it approaches and falling as it leaves (Doppler). The mod wheel sweeps the tone. Best with headphones.",
