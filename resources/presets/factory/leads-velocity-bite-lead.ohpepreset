{
  "format": "ohpe-preset",
  "version": 2,
  "kind": "part",
  "name": "Velocity Bite Lead",
  "author": "groovex",
  "tags": [
    "Leads"
  ],
  "engine": "wavetable",
  "comment": "A digital wavetable lead that bites harder the harder you play: velocity opens the tone and drives it (Hard), pressure adds vibrato. The mod wheel adds wavetable FM.",
  "params": {
    "engine": 1,
    "wavetable.table": 3,
    "wavetable.pos": 0.5,
    "wavetable.warp": 0.35,
    "wavetable.tone": 0.5,
    "wavetable.unison": 0.3,
    "wavetable.univoices": 3,
    "wavetable.uniwidth": 0.5,
    "wavetable.keytrack": 0.5,
    "wavetable.lfopos": 0.08,
    "amp.a": 0.004,
    "amp.d": 0.5,
    "amp.s": 0.8,
    "amp.r": 0.2,
    "mod.a": 0.002,
    "mod.d": 0.3,
    "mod.s": 0.3,
    "mod.r": 0.2,
    "mod.amt": 0.25,
    "voices": 4,
    "expr.vel.dst1": 1,
    "expr.vel.amt1": 0.45,
    "expr.vel.curve1": 1,
    "expr.vel.dst2": 18,
    "expr.vel.amt2": 0.35,
    "expr.vel.curve2": 1,
    "expr.at.dst1": 11,
    "expr.at.amt1": 0.22,
    "expr.at.curve1": 3,
    "lfo.rate": 0.1,
    "lfo.depth": 0.1,
    "lfo.shape": 1,
    "lfo.dest": 1,
    "fx.type": 10,
    "fx.compressor.thresh": -12,
    "fx.compressor.ratio": 3.0,
    "fx.compressor.attack": 2.0,
    "fx.compressor.release": 90,
    "fx.compressor.knee": 6.0,
    "fx.compressor.makeup": 0.0,
    "fx.compressor.mix": 1.0,
    "fx2.type": 5,
    "fx2.delay.time": 0.25,
    "fx2.delay.feedback": 0.25,
    "fx2.delay.tone": 0.5,
    "fx2.delay.pingpong": 1,
    "fx2.delay.mix": 0.14,
    "fx3.type": 6,
    "fx3.reverb.size": 0.45,
    "fx3.reverb.damping": 0.5,
    "fx3.reverb.predelay": 0.02,
    "fx3.reverb.mix": 0.12,
    "mod.s1.src": 9,
    "mod.s1.via": 0,
    "mod.s1.dst": 17,
    "mod.s1.amt": 0.35,
    "mod.s1.curve": 0,
    "velsens": 0.5,
    "glide": 0.0,
    "gain": 24.0,
    "chordroom": 5.9
  }
}
