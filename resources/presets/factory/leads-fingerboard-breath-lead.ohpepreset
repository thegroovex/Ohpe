{
  "format": "ohpe-preset",
  "version": 2,
  "kind": "part",
  "name": "Fingerboard Breath Lead",
  "author": "groovex",
  "tags": [
    "Leads",
    "MPE",
    "Fingerboard"
  ],
  "engine": "analog",
  "comment": "A breathy reed lead for continuous fingerboards: pressure is the breath (level, air and a brighter bore), forward / back opens the tone. Glide-free slides, quick response.",
  "params": {
    "engine": 2,
    "analog.shape": 0.15,
    "analog.detune": 0.0,
    "analog.cutoff": 4200,
    "analog.reso": 0.1,
    "analog.oscmix": 0.0,
    "analog.sub": 0.0,
    "analog.noise": 0.45,
    "analog.drive": 0.15,
    "analog.keytrack": 0.8,
    "analog.osclevel": 0.7,
    "amp.a": 0.12,
    "amp.d": 0.4,
    "amp.s": 0.85,
    "amp.r": 0.5,
    "mod.a": 0.2,
    "mod.d": 0.6,
    "mod.s": 0.4,
    "mod.r": 0.4,
    "mod.amt": 0.15,
    "reso.on": 1,
    "reso.model": 3,
    "reso.follow": 1,
    "reso.tune": 0.0,
    "reso.size": 0.4,
    "reso.material": 0.45,
    "reso.decay": 1.6,
    "reso.position": 0.15,
    "reso.inharm": 0.05,
    "reso.sympathetic": 0.0,
    "reso.width": 0.4,
    "reso.drive": 0.25,
    "reso.mix": 0.9,
    "reso.pressamt": 0.8,
    "reso.slideamt": 0.6,
