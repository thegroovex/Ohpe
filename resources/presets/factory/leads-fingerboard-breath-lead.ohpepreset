    "fx.reverb.mix": 0.15,
    "voices": 4,
    "glide": 0.0,
    "gain": 22.5,
    "mod.s1.src": 1,
    "mod.s1.via": 9,
    "mod.s1.dst": 1,
    "mod.s1.amt": 0.03,
    "mod.s1.curve": 0,
    "expr.at.curve1": 3,
