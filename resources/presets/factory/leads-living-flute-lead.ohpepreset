{
  "format": "ohpe-preset",
  "version": 2,
  "kind": "part",
  "name": "Living Flute Lead",
  "author": "groovex",
  "tags": [
    "Leads"
  ],
  "engine": "vocal",
  "comment": "A breathy flute-like voice whose pitch and breath drift a little with Life, like a real player. Pressure brings in vibrato and more breath, the mod wheel a wider vibrato.",
  "params": {
    "engine": 5,
    "vocal.vowel": 3.2,
    "vocal.formant": 2.5,
    "vocal.breath": 0.6,
    "vocal.tension": 0.3,
    "vocal.vibdepth": 0.0,
    "vocal.vibrate": 5.2,
    "vocal.jitter": 0.15,
    "amp.a": 0.06,
    "amp.d": 0.4,
    "amp.s": 0.85,
    "amp.r": 0.3,
    "mod.a": 0.05,
    "mod.d": 0.4,
    "mod.s": 0.4,
    "mod.r": 0.3,
    "mod.amt": 0.0,
    "voices": 2,
    "life": 0.5,
    "expr.vel.dst1": 5,
    "expr.vel.amt1": -0.3,
    "expr.vel.curve1": 0,
    "expr.at.dst1": 11,
    "expr.at.amt1": 0.25,
    "expr.at.curve1": 3,
    "expr.at.dst2": 15,
    "expr.at.amt2": 0.3,
    "expr.at.curve2": 0,
    "lfo.rate": 0.1,
    "lfo.depth": 0.1,
    "lfo.shape": 1,
    "lfo.dest": 1,
    "fx.type": 6,
    "fx.reverb.size": 0.55,
    "fx.reverb.damping": 0.5,
    "fx.reverb.predelay": 0.02,
    "fx.reverb.mix": 0.18,
    "mod.s1.src": 32,
    "mod.s1.via": 9,
    "mod.s1.dst": 1,
    "mod.s1.amt": 0.03,
    "mod.s1.curve": 0,
    "velsens": 0.4,
    "glide": 0.0,
    "gain": 10.8,
    "chordroom": 4.5
  }
}
