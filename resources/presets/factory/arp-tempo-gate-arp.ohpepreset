    "wavetable.uniwidth": 0.6,
    "wavetable.keytrack": 0.4,
    "wavetable.lfopos": 0.15,
    "amp.a": 0.003,
    "amp.d": 0.4,
    "amp.s": 0.7,
    "amp.r": 0.2,
    "mod.a": 0.002,
    "mod.d": 0.25,
    "mod.s": 0.2,
    "mod.r": 0.2,
