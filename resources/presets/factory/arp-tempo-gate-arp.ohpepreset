{
  "format": "ohpe-preset",
  "version": 2,
  "kind": "part",
  "name": "Tempo Gate Arp",
  "author": "groovex",
  "tags": [
    "Arp"
  ],
  "engine": "wavetable",
  "comment": "A glassy arpeggio chopped by a sixteenth-note gate that is locked to the tempo (LFO 2 on the level, retriggered with each note). Holds a chord, plays in time at any tempo; the mod wheel lifts the echoes.",
