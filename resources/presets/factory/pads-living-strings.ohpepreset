{
  "format": "ohpe-preset",
  "version": 2,
  "kind": "part",
  "name": "Living Strings",
  "author": "groovex",
  "tags": [
    "Pads"
  ],
  "engine": "analog",
  "comment": "An ensemble string pad that keeps moving while you hold it: Life gives every voice its own slow drift and breathing tone, Alive adds detune motion. The mod wheel opens the filter.",
  "params": {
    "engine": 2,
    "analog.shape": 0.0,
    "analog.detune": 0.28,
    "analog.cutoff": 1600,
    "analog.reso": 0.08,
    "analog.osc2oct": 1,
    "analog.oscmix": 0.4,
    "analog.sub": 0.0,
    "analog.drive": 0.1,
    "analog.keytrack": 0.6,
    "amp.a": 0.6,
    "amp.d": 1.0,
    "amp.s": 0.9,
    "amp.r": 1.6,
    "mod.a": 0.6,
    "mod.d": 1.2,
    "mod.s": 0.8,
    "mod.r": 1.2,
    "mod.amt": 0.08,
    "life": 0.8,
    "char.alive": 0.3,
    "char.wide": 0.2,
    "expr.vel.dst1": 5,
    "expr.vel.amt1": -0.25,
    "expr.vel.curve1": 0,
    "expr.at.dst1": 1,
    "expr.at.amt1": 0.3,
    "expr.at.curve1": 3,
    "fx.type": 1,
    "fx.chorus.rate": 0.25,
    "fx.chorus.depth": 0.6,
    "fx.chorus.mix": 0.38,
    "fx.chorus.voices": 4,
    "fx.chorus.drift": 0.45,
    "fx.chorus.spread": 0.85,
    "fx.chorus.lowcut": 180.0,
    "fx2.type": 6,
    "fx2.reverb.size": 0.75,
    "fx2.reverb.damping": 0.45,
    "fx2.reverb.predelay": 0.03,
    "fx2.reverb.mix": 0.25,
    "mod.s1.src": 9,
    "mod.s1.via": 0,
    "mod.s1.dst": 4,
    "mod.s1.amt": 0.45,
    "mod.s1.curve": 0,
    "voices": 12,
    "velsens": 0.3,
    "glide": 0.0,
    "gain": 13.1,
    "chordroom": 5.4
  }
}
