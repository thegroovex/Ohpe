{
  "format": "ohpe-preset",
  "version": 2,
  "kind": "part",
  "name": "Scattered Blocks",
  "author": "groovex",
  "tags": [
    "Drums",
    "3D"
  ],
  "engine": "pluck",
  "comment": "Wood blocks struck at random places around and above you, a new spot for every hit. Velocity sets the knock; the mod wheel lifts the hits overhead. Best with headphones.",
