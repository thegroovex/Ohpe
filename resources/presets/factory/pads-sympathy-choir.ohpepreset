{
  "format": "ohpe-preset",
  "version": 2,
  "kind": "part",
  "name": "Sympathy Choir",
  "author": "groovex",
  "tags": [
    "Pads",
    "Vocal"
  ],
  "engine": "vocal",
  "comment": "A soft 'ah' choir that sets a ring of sympathetic strings humming in the chord you hold, with Life drifting each voice. The strings keep ringing when the choir stops; the mod wheel moves the vowel towards 'oh'.",
  "params": {
    "engine": 5,
    "vocal.vowel": 0.0,
    "vocal.formant": 0.0,
    "vocal.breath": 0.35,
    "vocal.tension": 0.35,
    "vocal.vibdepth": 0.12,
    "vocal.vibrate": 5.0,
    "vocal.jitter": 0.2,
    "amp.a": 0.8,
    "amp.d": 1.5,
    "amp.s": 0.9,
    "amp.r": 2.0,
    "mod.a": 0.5,
    "mod.d": 2.0,
    "mod.s": 0.5,
    "mod.r": 1.5,
    "mod.amt": 0.0,
    "reso.on": 1,
    "reso.model": 0,
    "reso.follow": 2,
    "reso.tune": 0.0,
    "reso.size": 1.0,
    "reso.material": 0.55,
    "reso.decay": 5.0,
    "reso.position": 0.35,
    "reso.inharm": 0.1,
    "reso.sympathetic": 0.85,
    "reso.width": 0.9,
    "reso.drive": 0.0,
    "reso.mix": 0.35,
    "reso.pressamt": 0.5,
    "reso.slideamt": 0.5,
    "life": 0.55,
    "expr.at.dst1": 14,
    "expr.at.amt1": 0.25,
    "expr.at.curve1": 3,
    "fx.type": 6,
    "fx.reverb.size": 0.75,
    "fx.reverb.damping": 0.45,
    "fx.reverb.predelay": 0.03,
    "fx.reverb.mix": 0.22,
    "mod.s1.src": 9,
    "mod.s1.via": 0,
    "mod.s1.dst": 5,
    "mod.s1.amt": 0.2,
    "mod.s1.curve": 0,
    "voices": 10,
    "velsens": 0.25,
    "glide": 0.0,
    "gain": 5.2
  }
}
