{
  "format": "ohpe-preset",
  "version": 2,
  "kind": "part",
  "name": "Tempo Tide Pad",
  "author": "groovex",
  "tags": [
    "Pads"
  ],
  "engine": "wavetable",
  "comment": "A warm wavetable pad whose tone rises and falls over two bars and drifts through the stereo field over one bar - both locked to the tempo, they run with any song speed. The mod wheel deepens the tide.",
  "params": {
    "engine": 1,
    "wavetable.table": 1,
    "wavetable.pos": 0.35,
    "wavetable.warp": 0.15,
    "wavetable.tone": 0.48,
    "wavetable.unison": 0.4,
    "wavetable.univoices": 6,
    "wavetable.uniwidth": 0.85,
    "wavetable.keytrack": 0.4,
    "wavetable.lfopos": 0.0,
    "amp.a": 0.8,
    "amp.d": 1.5,
    "amp.s": 0.9,
    "amp.r": 2.2,
    "mod.a": 0.8,
    "mod.d": 1.5,
    "mod.s": 0.7,
    "mod.r": 1.8,
    "mod.amt": 0.1,
    "lfo.depth": 0.0,
    "lfo2.rate": 0.25,
    "lfo2.sync": 2,
    "lfo2.shape": 0,
    "lfo2.mode": 0,
    "lfo2.depth": 0.6,
    "lfo2.fade": 0.0,
    "lfo2.phase": 0.0,
    "lfo3.rate": 0.5,
    "lfo3.sync": 3,
    "lfo3.shape": 1,
    "lfo3.mode": 0,
    "lfo3.depth": 0.5,
    "lfo3.fade": 0.0,
    "lfo3.phase": 0.0,
    "expr.vel.dst1": 5,
    "expr.vel.amt1": -0.2,
    "expr.vel.curve1": 0,
    "expr.at.dst1": 14,
    "expr.at.amt1": 0.3,
    "expr.at.curve1": 3,
    "fx.type": 1,
    "fx.chorus.rate": 0.25,
    "fx.chorus.depth": 0.6,
    "fx.chorus.mix": 0.3,
    "fx.chorus.voices": 4,
    "fx.chorus.drift": 0.45,
    "fx.chorus.spread": 0.85,
    "fx.chorus.lowcut": 180.0,
    "fx2.type": 6,
    "fx2.reverb.size": 0.75,
    "fx2.reverb.damping": 0.45,
    "fx2.reverb.predelay": 0.03,
    "fx2.reverb.mix": 0.25,
    "mod.s1.src": 2,
    "mod.s1.via": 0,
    "mod.s1.dst": 5,
    "mod.s1.amt": 0.3,
    "mod.s1.curve": 0,
    "mod.s2.src": 3,
    "mod.s2.via": 0,
    "mod.s2.dst": 3,
    "mod.s2.amt": 0.35,
    "mod.s2.curve": 0,
    "mod.s3.src": 9,
    "mod.s3.via": 0,
    "mod.s3.dst": 33,
    "mod.s3.amt": 0.4,
    "mod.s3.curve": 0,
    "voices": 10,
    "velsens": 0.25,
    "glide": 0.0,
    "gain": 0.5
  }
}
