{
  "format": "ohpe-preset",
  "version": 2,
  "kind": "part",
  "name": "Pressure Glide Bass",
  "author": "groovex",
  "tags": [
    "Bass"
  ],
  "engine": "analog",
  "comment": "A legato mono bass that slides between overlapping notes. Pressure stretches the slide (pressure glide): a light touch keeps it tight, leaning in turns it into a slow swoop. The mod wheel opens the filter.",
  "params": {
    "engine": 2,
    "analog.shape": 0.25,
    "analog.detune": 0.08,
    "analog.cutoff": 520,
    "analog.reso": 0.3,
    "analog.oscmix": 0.35,
    "analog.osc2oct": -1,
    "analog.sub": 0.35,
    "analog.drive": 0.35,
    "analog.keytrack": 0.5,
    "amp.a": 0.003,
    "amp.d": 0.5,
    "amp.s": 0.8,
    "amp.r": 0.09,
    "mod.a": 0.002,
    "mod.d": 0.3,
    "mod.s": 0.2,
    "mod.r": 0.12,
    "mod.amt": 0.35,
    "voices": 1,
    "glide": 0.07,
    "glide.mode": 1,
    "glide.rate": 0,
    "glide.press": 0.75,
    "expr.vel.dst1": 1,
    "expr.vel.amt1": 0.3,
    "expr.vel.curve1": 0,
    "lfo.rate": 0.17,
    "lfo.depth": 0.1,
    "lfo.shape": 1,
    "lfo.dest": 1,
    "fx.type": 10,
    "fx.compressor.thresh": -14,
    "fx.compressor.ratio": 3.0,
    "fx.compressor.attack": 2.0,
    "fx.compressor.release": 90,
    "fx.compressor.knee": 6.0,
    "fx.compressor.makeup": 0.0,
    "fx.compressor.mix": 1.0,
    "mod.s1.src": 9,
    "mod.s1.via": 0,
    "mod.s1.dst": 4,
    "mod.s1.amt": 0.5,
    "mod.s1.curve": 0,
    "monobass": 150.0,
    "velsens": 0.4,
    "gain": 24.0,
    "chordroom": 4.5
  }
}
