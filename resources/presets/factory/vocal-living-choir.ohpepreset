{
  "format": "ohpe-preset",
  "version": 2,
  "kind": "part",
  "name": "Living Choir",
  "author": "groovex",
  "tags": [
    "Vocal",
    "Pads"
  ],
  "engine": "vocal",
  "comment": "A wide 'ah' choir where every singer drifts on their own (Life full up, Alive and Wide on): it sounds like a group, not a copy. The mod wheel adds a wider choir vibrato.",
  "params": {
    "engine": 5,
    "vocal.vowel": 0.0,
    "vocal.formant": 0.0,
    "vocal.breath": 0.4,
    "vocal.tension": 0.35,
    "vocal.vibdepth": 0.14,
    "vocal.vibrate": 5.0,
    "vocal.jitter": 0.25,
    "amp.a": 0.7,
    "amp.d": 1.5,
    "amp.s": 0.9,
    "amp.r": 1.8,
    "mod.a": 0.5,
    "mod.d": 2.0,
    "mod.s": 0.5,
    "mod.r": 1.5,
    "mod.amt": 0.0,
    "lfo.rate": 0.09,
    "lfo.depth": 0.2,
    "lfo.shape": 1,
    "lfo.dest": 1,
    "life": 0.9,
    "char.alive": 0.35,
    "char.wide": 0.4,
    "expr.at.dst1": 11,
    "expr.at.amt1": 0.15,
    "expr.at.curve1": 3,
    "fx.type": 1,
    "fx.chorus.rate": 0.3,
    "fx.chorus.depth": 0.5,
    "fx.chorus.mix": 0.3,
    "fx.chorus.voices": 3,
    "fx.chorus.drift": 0.35,
    "fx.chorus.spread": 0.85,
    "fx.chorus.lowcut": 200.0,
    "fx2.type": 6,
    "fx2.reverb.size": 0.75,
    "fx2.reverb.damping": 0.45,
    "fx2.reverb.predelay": 0.03,
    "fx2.reverb.mix": 0.22,
    "mod.s1.src": 32,
    "mod.s1.via": 9,
    "mod.s1.dst": 1,
    "mod.s1.amt": 0.02,
    "mod.s1.curve": 0,
    "voices": 12,
    "velsens": 0.3,
    "glide": 0.0,
    "gain": 8.4
  }
}
