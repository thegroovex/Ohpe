{
  "format": "ohpe-preset",
  "version": 2,
  "kind": "project",
  "name": "Arp Study",
  "author": "groovex",
  "tags": [
    "Arp",
    "Plucks"
  ],
  "engine": "pluck",
  "comment": "Placeholder for testing the library; the real factory sounds follow in a later version.",
  "params": {
    "tempo": 112,
    "p1.engine": 3,
    "p1.pluck.damping": 0.5,
    "seq.arp.on": 1,
    "seq.arp.part": 1,
    "seq.arp.mode": 2,
    "seq.arp.oct": 2,
    "seq.arp.rate": 2,
    "seq.arp.latch": 1,
    "mix.returna": 0.4,
    "mix.ch1.senda": 0.35
  }
}
