{
  "format": "ohpe-preset",
  "version": 2,
  "kind": "part",
  "name": "Helix Sequence",
  "author": "groovex",
  "tags": [
    "Arp",
    "3D"
  ],
  "engine": "wavetable",
  "comment": "A glassy wavetable arpeggio on a helix around your head: it circles up above you over two bars and spirals back down over the next two. The mod wheel sweeps the wavetable. Best with headphones.",
